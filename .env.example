# LifeOS environment variables — copy to .env and fill in values.
# .env is git-ignored. This file is the source of truth for defaults & docs.

# ── GitHub (required) ─────────────────────────────────────────
# PAT with repo access for the skill repo below.
GITHUB_TOKEN=
GITHUB_OWNER=thein3rovert
GITHUB_REPO=polis

# ── Backend (Go server) ────────────────────────────────────────
# Port the Go backend listens on (inside its container / native process).
LIFEOS_PORT=6060

# URL the Go backend uses to reach the sidecar.
# - Native dev:            http://localhost:3002
# - Docker/podman compose: http://sidecar:3002  (service name resolution)
SIDECAR_URL=http://localhost:3002

# Comma-separated list of allowed CORS origins.
# Must include every host/port the frontend can be served from.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# MCP endpoint auth key.
MCP_API_KEY=

# ── Frontend ──────────────────────────────────────────────────
# Runtime backend URL, injected into browser via window.APP_CONFIG at SSR.
# Leave empty to auto-detect from window.location (see web/src/lib/apiUrl.ts).
# Example for Tailscale: http://100.105.217.77:6060
API_URL=

# ── Sidecar ───────────────────────────────────────────────────
# Port the Node sidecar listens on (inside its container / native process).
PORT=3002

# URL of the OpenCode server the sidecar delegates to.
# - Native:   http://localhost:4097
# - Compose:  http://host.containers.internal:4097  (podman) or host.docker.internal (docker)
OPENCODE_URL=http://localhost:4097
