# LifeOS environment variables — copy to .env and fill in values.
# .env is git-ignored. This file is the source of truth for defaults & docs.

# ── GitHub (required) ─────────────────────────────────────────
# PAT with repo access for the skill repo below.
GITHUB_TOKEN=
GITHUB_OWNER=thein3rovert
GITHUB_REPO=polis

# ── Backend (Go server) ────────────────────────────────────────
# Port the Go backend listens on (inside its container / native process).
LIFEOS_PORT=6060

# External ports for docker-compose (prevents conflicts between dev/prod).
# These are used to construct URLs automatically (see config.go).
# Dev: 6060, 3050, 3002 | Prod: 7060, 7001, 7002
BACKEND_PORT=7060
FRONTEND_PORT=7001
SIDECAR_PORT=7002

# Path to the SQLite database file.
LIFEOS_DB_PATH=lifeos.db

# Public URL used for MCP SSE base and any share links.
# DEPRECATED: Set BACKEND_PORT instead. This will be removed in a future version.
# The code now constructs the URL from BACKEND_PORT automatically.
LIFEOS_PUBLIC_URL=

# URL the Go backend uses to reach the sidecar.
# - Native dev:            http://localhost:3002
# - Docker/podman compose: http://sidecar:3002  (service name resolution)
SIDECAR_URL=http://localhost:3002

# Comma-separated list of allowed CORS origins.
# For self-hosted single-user deployments, set to * to allow any origin:
#   CORS_ORIGINS=*
# This is safe because authentication (MCP_API_KEY, OAuth) is the real security.
# For multi-user or public deployments, list specific origins:
#   CORS_ORIGINS=http://localhost:3050,http://100.x.x.x:3050
CORS_ORIGINS=*

# MCP endpoint auth key.
MCP_API_KEY=

# Comma-separated absolute paths the MCP server may read from.
# Leave empty to disable MCP file access.
MCP_ALLOWED_DIRS=

# Smart board content paths (Obsidian vault subfolders the AI scans).
LIFEOS_MEETINGS_PATH=
LIFEOS_JOURNAL_PATH=

# ── Google Calendar OAuth (LOS-014) ─────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Create at https://console.cloud.google.com/apis/credentials (see
# doc/google-calendar-oauth-setup.md for the full runbook).
# - Application type: Web application
# - Authorized redirect URI: http://localhost:6060/api/calendar/oauth/callback
#   (must match the value of GOOGLE_REDIRECT_URI below exactly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:6060/api/calendar/oauth/callback

# ── Frontend URL (backend → browser) ───────────────────────────
# Used by the backend to redirect the browser after OAuth callbacks etc.
# DEPRECATED: Set FRONTEND_PORT instead. This will be removed in a future version.
# The code now constructs the URL from FRONTEND_PORT automatically.
FRONTEND_URL=

# ── Sidecar ───────────────────────────────────────────────────

# URL of the OpenCode server the sidecar delegates to.
# - Native:   http://localhost:4097
# - Compose:  http://host.containers.internal:4097  (podman) or host.docker.internal (docker)
OPENCODE_URL=http://localhost:4097
